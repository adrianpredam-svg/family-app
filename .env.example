# Postgres connection (Coolify gives you this when you create the database)
DATABASE_URL=postgres://family:family@localhost:5432/family

# Long random string: generate with `openssl rand -base64 32`
SESSION_SECRET=change-me-to-a-long-random-string

# Family members: Name:PIN:#colour, comma separated. PIN = 4-6 digits.
FAMILY_MEMBERS=Adrian:1234:#2563eb,Ana:5678:#db2777

# Web Push keys: generate once with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:adrian@preda.app

# Public address of the app
APP_URL=https://preda.app

# Preview deployments only: seed demo members (PIN 0000) and demo tasks
SEED_DEMO_DATA=false
